<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:id="@+id/card_entry_horse"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- お気に入り（タップで登録・解除） -->
            <TextView
                android:id="@+id/text_entry_favorite"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="☆"
                android:textColor="@color/oshi_line"
                android:textSize="22sp" />

            <!-- 自分の予想の印（タップで ◎→○→▲→△→なし。印が無い間は薄く「印」） -->
            <TextView
                android:id="@+id/text_entry_mark"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_mark"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- 馬番（背景は枠の色） -->
            <TextView
                android:id="@+id/text_entry_number"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_entry_horse"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_entry_jockey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/oshi_card_ink_soft"
                android:textSize="13sp" />

            <!-- 馬メモ（タップで書く・直す。メモが無い間は薄く表示） -->
            <TextView
                android:id="@+id/text_entry_memo"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_memo"
                android:gravity="center"
                android:text="📝"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- 自分の馬メモ（メモがある時だけ表示。タップで直す） -->
        <TextView
            android:id="@+id/text_entry_memo_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/oshi_spot_to"
            android:padding="8dp"
            android:textColor="@color/oshi_card_ink"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 当日の情報（馬体重・出走取消・騎手変更）。keibalab から取れたら表示 -->
        <TextView
            android:id="@+id/text_entry_today"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/oshi_card_ink"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- このレースの結果（確定したら表示） -->
        <TextView
            android:id="@+id/text_entry_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 単勝・複勝オッズ（取れた時だけ表示） -->
        <TextView
            android:id="@+id/text_entry_odds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/oshi_card_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 予想の手がかり（レース間隔・距離変更・乗り替わりなど） -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/entry_badges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="4dp" />

        <!-- 近走成績（コードで追加する） -->
        <LinearLayout
            android:id="@+id/entry_past_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
