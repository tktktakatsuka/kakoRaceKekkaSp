<?xml version="1.0" encoding="utf-8"?>
<!-- 近走1走分（日付・場・レース名・距離・着順(人気)）。タップでそのレースの結果へ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="5dp">

    <TextView
        android:id="@+id/text_run_date"
        android:layout_width="94dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/oshi_ink_soft"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/text_run_course"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:textColor="@color/oshi_ink_soft"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/text_run_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/oshi_ink"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/text_run_distance"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/oshi_ink_soft"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/text_run_result"
        android:layout_width="68dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textSize="13sp" />
</LinearLayout>
