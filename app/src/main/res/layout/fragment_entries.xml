<?xml version="1.0" encoding="utf-8"?>
<!-- 出走表の一覧（EntriesFragment）とレースごとの出走表（EntryDetailFragment）で共用する -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.tktkcompany.kakoRaceKeiba.ui.entries.EntriesFragment">

    <ScrollView
        android:id="@+id/scroll_entries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/text_entries_lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/oshi_ink_soft"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/text_entries_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:textColor="@color/oshi_ink_soft"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- 開催日・競馬場ごとのレース一覧（コードで追加する） -->
            <LinearLayout
                android:id="@+id/entries_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- バナーの枠（中の広告は BannerAd がコードで入れる） -->
    <FrameLayout
        android:id="@+id/ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
