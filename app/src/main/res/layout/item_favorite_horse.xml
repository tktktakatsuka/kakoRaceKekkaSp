<?xml version="1.0" encoding="utf-8"?>
<!-- お気に入り馬1頭分。馬名・出走予定・前走を詰めて並べる。外すのは右の小さな × から -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_favorite"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="12dp"
        android:paddingStart="14dp"
        android:paddingEnd="4dp">

        <!-- 馬のアイコン（選んだ絵文字か馬のイラスト。CardStyles がコードで入れる） -->
        <FrameLayout
            android:id="@+id/avatar_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_horse_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/oshi_card_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 称号のバッジと貢いだ金額（買い目のある推し馬だけ。中身は FavoriteHorsesAdapter が入れる） -->
            <LinearLayout
                android:id="@+id/mitsugi_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- 出走予定（出馬表に名前がある時だけ表示。タップでそのレースの出走表へ） -->
            <TextView
                android:id="@+id/text_next_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackground"
                android:textColor="@color/oshi_card_accent"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- 前走・速報（タップでそのレース結果へ） -->
            <TextView
                android:id="@+id/text_latest_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="?attr/selectableItemBackground"
                android:textColor="@color/oshi_card_ink_soft"
                android:textSize="13sp" />

            <!-- 前走・速報が1着のときだけ出す。押すと共有メニュー（X・LINE など）を開く -->
            <TextView
                android:id="@+id/btn_share_win"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_share_win"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="@color/oshi_card_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 右側：カードを飾る（上）と、推し馬から外す（下） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btn_decorate"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_decorate_card"
                android:gravity="center"
                android:text="🎨"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/btn_delete"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_remove_favorite"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/oshi_line" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
