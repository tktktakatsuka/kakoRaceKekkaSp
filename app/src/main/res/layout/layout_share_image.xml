<?xml version="1.0" encoding="utf-8"?>
<!-- 共有画像のサイズに合わせて幅と高さを指定 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="16dp">

    <!-- アプリアイコンとタイトル -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/ic_launcher_round" /> <!-- あなたのアプリの丸いアイコン -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI競馬アナリスト"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/oshi_line"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"/>

    <!-- AIの分析結果がここに表示される -->
    <TextView
        android:id="@+id/textViewShareContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ここにAIの分析結果のテキストが入ります。長文の場合は折り返されます..."
        android:textColor="@android:color/black"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="\n#AI競馬 #競馬予想 #tktkcompany #https://play.google.com/store/apps/details?id=com.tktkcompany.kakoRaceKeiba"
        android:textColor="@color/oshi_accent"
        android:gravity="end"
        android:layout_marginTop="16dp"/>

</LinearLayout>