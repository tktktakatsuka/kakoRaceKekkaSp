<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- アプリのテーマ（Material 3、金色とクリーム）。色は colors.xml の oshi_*。夜は values-night で上書きする -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/oshi_brown</item>
        <item name="colorOnPrimary">@color/oshi_on_brown</item>
        <item name="colorPrimaryContainer">@color/oshi_gold</item>
        <item name="colorOnPrimaryContainer">@color/oshi_ink</item>
        <item name="colorSecondary">@color/oshi_amber</item>
        <item name="colorSecondaryContainer">@color/oshi_nav_active</item>
        <item name="colorOnSecondaryContainer">@color/oshi_ink</item>
        <item name="colorSurface">@color/oshi_surface</item>
        <item name="colorOnSurface">@color/oshi_ink</item>
        <item name="colorOnSurfaceVariant">@color/oshi_ink_soft</item>
        <item name="colorSurfaceContainer">@color/oshi_nav</item>
        <item name="android:colorBackground">@color/oshi_bg</item>
        <item name="colorOnBackground">@color/oshi_ink</item>
        <item name="colorOutline">@color/oshi_line</item>
        <item name="colorError">@color/oshi_danger</item>
        <item name="android:statusBarColor">@color/oshi_bg</item>
        <item name="android:navigationBarColor">@color/oshi_nav</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication">
        <!-- 昼はステータスバーのアイコンを暗く -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- 上の帯の題名（太字で少し小さめ） -->
    <style name="TextAppearance.Oshi.ToolbarTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/oshi_ink</item>
    </style>
</resources>
